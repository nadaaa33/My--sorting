def insertion_sort(arr):
    a = list(arr)
    comparisons = 0
    shifts = 0
    
    for i in range(1, len(a)):
        key = a[i]
        j = i - 1
        
        while j >= 0:
            comparisons += 1
            if a[j] > key:
                a[j + 1] = a[j]
                shifts += 1
                j -= 1
            else:
                break
        a[j + 1] = key
        
    return a, comparisons, shifts

sample_data = [12, 11, 13, 5, 6]
sorted_arr, comps, shfts = insertion_sort(sample_data)

print("Original Array:", sample_data)
print("Sorted Array:", sorted_arr)
print("Comparisons:", comps)
print("Shifts:", shfts)
